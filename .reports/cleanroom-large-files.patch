new file mode 100644
index 0000000..09060da
--- /dev/null
+++ b/scripts/render-flow.mjs
@@ -0,0 +1,21 @@
+import { readFile, writeFile } from "node:fs/promises";
+import { basename } from "node:path";
+import { parse } from "yaml";
+
+const path = "specs/scanning/files/scanning-a-file.flow.yaml";
+const contract = parse(await readFile(path, "utf8"));
+const lines = [`%% Generated from ${basename(path)}. Do not edit directly.`, "stateDiagram-v2"];
+for (const flow of contract.flows) {
+  const stateId = (id) => `${flow.id}_${id}`;
+  lines.push(`    [*] --> ${stateId(flow.start)}`, "");
+  for (const state of flow.states) lines.push(`    ${stateId(state.id)}: ${state.label}`);
+  lines.push("");
+  for (const transition of flow.transitions)
+    lines.push(
+      `    ${stateId(transition.from)} --> ${stateId(transition.to)}: ${transition.event}`,
+    );
+  lines.push("");
+  for (const state of flow.states.filter((candidate) => candidate.kind === "terminal"))
+    lines.push(`    ${stateId(state.id)} --> [*]`);
+}
+await writeFile(path.replace(/\.yaml$/, ".mmd"), `${lines.join("\n")}\n`);
