diff --git a/src/scanner/docker-config.test.ts b/src/scanner/docker-config.test.ts
new file mode 100644
index 0000000..e93278e
--- /dev/null
+++ b/src/scanner/docker-config.test.ts
@@ -0,0 +1,39 @@
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { SCAN_SIZE_CAP_BYTES } from "../domain/limits.js";
+
+it("replaces Debian size limits instead of leaving an earlier limit active", () => {
+  const directory = mkdtempSync(join(tmpdir(), "cleanroom-clamd-"));
+  try {
+    const clamd = join(directory, "clamd.conf");
+    const freshclam = join(directory, "freshclam.conf");
+    writeFileSync(
+      clamd,
+      "LocalSocket /var/run/clamav/clamd.ctl\nStreamMaxLength 25M\nMaxFileSize 25M\nMaxScanSize 100M\nAlertExceedsMax no\n",
+    );
+    writeFileSync(freshclam, "Example\n");
+    const dockerfile = readFileSync(new URL("../../Dockerfile", import.meta.url), "utf8");
+    const command = dockerfile.match(/RUN sed -i [\s\S]*?(?=\n\n)/)?.[0];
+    if (!command) throw new Error("missing ClamAV configuration build step");
+    execFileSync("sh", [
+      "-c",
+      command
+        .slice(4)
+        .replaceAll("sed -i", "sed -i.bak")
+        .replaceAll("/etc/clamav/clamd.conf", clamd)
+        .replaceAll("/etc/clamav/freshclam.conf", freshclam),
+    ]);
+    const configuration = readFileSync(clamd, "utf8");
+    for (const setting of ["StreamMaxLength", "MaxFileSize", "MaxScanSize"]) {
+      expect(configuration.match(new RegExp(`^${setting} .*$`, "gm"))).toEqual([
+        `${setting} ${SCAN_SIZE_CAP_BYTES / (1024 * 1024)}M`,
+      ]);
+    }
+    expect(configuration.match(/^AlertExceedsMax .*$/gm)).toEqual(["AlertExceedsMax yes"]);
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
